# Copy to .env.dev (ignored by git) and replace every value marked CHANGE.
# Used by docker compose for the app and for PostgreSQL. Never commit .env.dev.
# Variables are described in docs/architecture.md.

APP_ENV=local
BASE_URL=http://localhost:8000

# PostgreSQL (container "db"). The password here must match DATABASE_URL.
POSTGRES_USER=silo
POSTGRES_PASSWORD=CHANGE-me-database-password
POSTGRES_DB=silo
DATABASE_URL=postgresql+asyncpg://silo:CHANGE-me-database-password@db:5432/silo

# Real Azure Blob Storage, one private container per developer (there is no emulator).
# The connection string must contain the account key; it is needed to sign SAS URLs.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=CHANGE;AccountKey=CHANGE;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=silo-local-CHANGE

# Secrets: at least 32 bytes each and different from each other
# (for example: python -c "import secrets; print(secrets.token_urlsafe(48))").
JWT_SECRET=CHANGE-me-jwt-secret-at-least-32-bytes
CSRF_SECRET=CHANGE-me-csrf-secret-at-least-32-bytes
JWT_ISSUER=silo
JWT_AUDIENCE=silo-local

# Local development only: plain HTTP, open registration, API docs on.
COOKIE_SECURE=false
REGISTRATION_MODE=open
ENABLE_DOCS=true

# First admin, created at startup if it does not exist (username: 3-32 characters, a-z 0-9 . _ -).
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=CHANGE-me-admin-password

# 100 MiB
MAX_FILE_SIZE_BYTES=104857600

# Storage limits in bytes. Quotas are per role; the total cap is for all users together.
# 1 GiB
QUOTA_USER_BYTES=1073741824
# 5 GiB
QUOTA_TEAM_LEAD_BYTES=5368709120
# 10 GiB
QUOTA_ADMIN_BYTES=10737418240
# 0 = no total cap; for example 53687091200 = 50 GiB
STORAGE_TOTAL_MAX_BYTES=0

# Prometheus metrics on an internal port (0 = off). Never the app port 8000.
METRICS_PORT=9000
